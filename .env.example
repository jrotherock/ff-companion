# Copy these into Railway → your service → Variables.

# Required once the app is reachable from anywhere but your own Mac. Any long
# random string; generate one with:  openssl rand -hex 24
APP_TOKEN=

# Where mutable state lives. Must match the mount path of the Railway volume,
# or every deploy wipes the Yahoo captures, the push subscriptions and the
# snapshots the sensor needs to know what changed.
STATE_DIR=/app/state

# Your Sleeper user id. Already the default; set it only if it ever changes.
# SLEEPER_USER=862745311741882368

# Optional second channel for alerts that cannot be recovered if missed.
# From pushover.net — the app token and your user key.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Railway sets PORT itself. Do not set it.
