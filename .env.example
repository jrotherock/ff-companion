# Copy these into Railway → your service → Variables.

# Required once the app is reachable from anywhere but your own Mac. Any long
# random string; generate one with:  openssl rand -hex 24
APP_TOKEN=

# Where mutable state lives. Must match the mount path of the Railway volume,
# or every deploy wipes the Yahoo captures, the push subscriptions and the
# snapshots the sensor needs to know what changed.
STATE_DIR=/app/state

# Your Sleeper user id. Required — there is no default, because a hardcoded one
# would quietly read somebody else's roster in a fork.
SLEEPER_USER=

# Which leagues this instance is for, as a JSON array. This is how a hosted
# instance gets its leagues without committing them to a public repository.
# Locally, data/leagues/*.json is used instead and this stays unset.
# LEAGUES_JSON=[{"id":"...","label":"...","leagueKey":"..."}]

# Where the push services should write if this misbehaves. Not a secret, but
# personal, so it is not baked into the repo.
CONTACT_EMAIL=

# Optional second channel for alerts that cannot be recovered if missed.
# From pushover.net — the app token and your user key.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# Railway sets PORT itself. Do not set it.
