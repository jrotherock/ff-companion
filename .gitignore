node_modules/
.DS_Store
*.log

# Working files, not part of the project
scratch/

# Personal draft board: like / do-not-draft lists. Kept out of a public repo so
# leaguemates cannot read your targets. The strategy rules stay in.
data/preferences/*.json
!data/preferences/*.rules.json

# Live draft state — regenerated at the table, changes every pick
fixtures/log-*.jsonl

# Draft archive: manifests and frozen boards are local history, not source
fixtures/drafts/

# Leagues discovered from an open draft room are built at runtime
data/rankings-yahoo-live-*.json
data/leagues/yahoo-live-*.json

# Recorded raw adapter payloads can get large; keep the curated ones only
fixtures/raw-*.json

# Poller state: rewritten every ten minutes, so it churns the history for
# nothing. The snapshots are a cache of Sleeper, rebuildable on the next run.
fixtures/news-log.jsonl
fixtures/player-snapshot.json
fixtures/trending-snapshot.json
fixtures/notifications.json
fixtures/yahoo-rosters.json
fixtures/board-snapshot.json
